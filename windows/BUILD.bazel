load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

WIN_ONLY = ["@platforms//os:windows"]

# ---------------------------------------------------------------------------
# 1. Windows Core Logic & Unit Tests
# ---------------------------------------------------------------------------

cc_library(
    name = "app_version",
    srcs = ["app-version.cc"],
    hdrs = ["app-version.h"],
    target_compatible_with = WIN_ONLY,
    deps = ["@abseil-cpp//absl/strings"],
)

cc_test(
    name = "app_version_test",
    size = "small",
    srcs = ["app-version_test.cc"],
    target_compatible_with = WIN_ONLY,
    deps = [
        ":app_version",
        "@googletest//:gtest_main",
    ],
)

genrule(
    name = "generate_localization_tables",
    srcs = [
        "//:OKeyTre/en.lproj/Localizable.strings",
        "//:OKeyTre/vi.lproj/Localizable.strings",
        "resources/en.overrides.strings",
        "resources/vi.overrides.strings",
    ],
    outs = [
        "localization-keys.generated.h",
        "localization-tables.generated.h",
    ],
    cmd = (
        "$(location //l10nc:l10nc) " +
        "--en_base=$(location //:OKeyTre/en.lproj/Localizable.strings) " +
        "--en_overrides=$(location resources/en.overrides.strings) " +
        "--vi_base=$(location //:OKeyTre/vi.lproj/Localizable.strings) " +
        "--vi_overrides=$(location resources/vi.overrides.strings) " +
        "--out_keys=$(location localization-keys.generated.h) " +
        "--out_tables=$(location localization-tables.generated.h)"
    ),
    target_compatible_with = WIN_ONLY,
    tools = ["//l10nc:l10nc"],
)

cc_library(
    name = "localization",
    srcs = [
        "localization.cc",
        "localization-tables.generated.h",
    ],
    hdrs = [
        "localization.h",
        "localization-keys.generated.h",
    ],
    target_compatible_with = WIN_ONLY,
    deps = ["@abseil-cpp//absl/strings"],
)

cc_test(
