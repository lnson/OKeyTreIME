# ---------------------------------------------------------------------------
# 2. Native Win32 Resource Compilation & Desktop Application (`OKeyTre.exe`)
# ---------------------------------------------------------------------------

genrule(
    name = "okeytre_resources",
    srcs = [
        "resources/okeytre.ico",
        "resources/okeytre.manifest",
        "resources/okeytre.rc",
        "resources/resource.h",
        "resources/tray-off.ico",
        "resources/tray-vi.ico",
    ],
    outs = ["okeytre.res"],
    cmd = "echo 'Windows resource compilation requires Windows' >&2 && exit 1",
    cmd_bat = (
        "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"" +
        "$$rc = (Get-Command rc.exe -ErrorAction SilentlyContinue).Source; " +
        "if (-not $$rc) { $$rc = (Get-ChildItem 'C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.*\\x64\\rc.exe' | Sort-Object FullName -Descending | Select-Object -First 1).FullName }; " +
        "if (-not $$rc) { throw 'Windows SDK rc.exe not found' }; " +
        "& $$rc /nologo /c65001 /i windows/resources /fo '$@' '$(location resources/okeytre.rc)'; " +
        "exit $$LASTEXITCODE\""
    ),
    target_compatible_with = WIN_ONLY,
)

WINDOWS_COPTS = [
    "/DUNICODE",
    "/D_UNICODE",
    "/DWINVER=0x0A00",
    "/D_WIN32_WINNT=0x0A00",
    "/DNTDDI_VERSION=0x0A000008",
]

cc_library(
    name = "okeytre_win_ui",
    srcs = [
        "app.cc",
        "caret-text-reader.cc",
        "input-source-manager.cc",
        "key-hook-manager.cc",
        "launch-at-login.cc",
        "settings-window.cc",
        "showcase-window.cc",
        "tray-icon.cc",
        "ui-theme.cc",
        "update-manager.cc",
    ],
    hdrs = [
        "app.h",
        "caret-text-reader.h",
        "input-source-manager.h",
        "key-hook-manager.h",
        "launch-at-login.h",
        "resources/resource.h",
        "settings-window.h",
        "showcase-window.h",
        "tray-icon.h",
        "ui-theme.h",
        "update-manager.h",
    ],
    copts = WINDOWS_COPTS,
    target_compatible_with = WIN_ONLY,
    deps = [
        ":app_version",
        ":ime_controller",
        ":localization",
        ":settings_store",
        ":shortcut_detectors",
        ":update_parser",
        "//OKeyTre/ime/core:OKeyTreEngineLib",
        "@abseil-cpp//absl/base",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/cleanup",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
    ],
)

cc_binary(
    name = "OKeyTre",
    srcs = ["main.cc"],
    additional_linker_inputs = [":okeytre_resources"],
    copts = WINDOWS_COPTS,
    linkopts = [
        "/SUBSYSTEM:WINDOWS",
        "/ENTRY:wWinMainCRTStartup",
        "$(location :okeytre_resources)",
        "advapi32.lib",
        "comctl32.lib",
        "dwmapi.lib",
        "gdi32.lib",
        "gdiplus.lib",
        "ole32.lib",
        "oleaut32.lib",
        "shell32.lib",
        "shlwapi.lib",
        "uiautomationcore.lib",
        "user32.lib",
        "uxtheme.lib",
        "winhttp.lib",
    ],
    target_compatible_with = WIN_ONLY,
    deps = [":okeytre_win_ui"],
)
