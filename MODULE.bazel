module(
    name = "okeytre",
    version = "1.0.0",
)

bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "google_benchmark", version = "1.10.0")
bazel_dep(name = "googletest", version = "1.18.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_apple", version = "5.4.0", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_swift", version = "4.3.0", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "apple_support", version = "2.12.0", repo_name = "build_bazel_apple_support")
bazel_dep(name = "simdutf", version = "9.4.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "uni_algo",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "uni_algo",
    srcs = ["src/data.cpp"],
    hdrs = glob(["include/**/*.h"]),
    copts = ["-std=c++23"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "f2a1539cd8635bc6088d05144a73ecfe7b4d74ee0361fabed6f87f9f19e74ca9",
    strip_prefix = "uni-algo-1.2.0",
    urls = ["https://github.com/uni-algo/uni-algo/archive/refs/tags/v1.2.0.tar.gz"],
)
